# Meshtastic Mesh Monitor - Environment Configuration
# Copy this file to .env and customize for your setup

# ============================================================================
# RADIO CONNECTION (Required)
# ============================================================================
# IP address or hostname of your Meshtastic device (for TCP/network connection)
TCP_SERVER=192.168.68.73

# SERIAL CONNECTION (Optional - for direct USB/serial connection)
# To use serial instead of TCP, uncomment docker-compose.yml devices section
# and set SERIAL_DEVICE to your port:
# - Linux: /dev/ttyUSB0, /dev/ttyACM0, /dev/ttyUSB1, etc.
# - Windows: COM3, COM4, etc.
# - macOS: /dev/tty.usbserial-*, /dev/tty.usbmodem*, etc.
# SERIAL_DEVICE=/dev/ttyUSB0

# NOTE: TCP_PORT is not configurable (hardcoded to 4403)

# ============================================================================
# NODE POSITION (Optional)
# ============================================================================
# Set your radio's fixed GPS position (will be sent to mesh on connection)
# Leave empty if you want to use GPS from the device itself
# NODE_LATITUDE=40.7128
# NODE_LONGITUDE=-74.0060
# NODE_ALTITUDE=10

# ============================================================================
# AI CONFIGURATION (Optional)
# ============================================================================
# Google Gemini API key for intelligent mesh responses
# Get a free API key: https://ai.google.dev
# Leave empty if you don't want AI features
GEMINI_API_KEY=

# ============================================================================
# DATA STORAGE (Usually auto-detected)
# ============================================================================
# Path to mesh data file (will be created if it doesn't exist)
# Docker: /data/mesh_data.json (shared volume)
# Local: ./data/mesh_data.json
MESH_DATA_FILE=/data/mesh_data.json

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Python paths (usually auto-configured, only change if needed)
# PYTHONPATH=/app
# PYTHONUNBUFFERED=1
