# Meshtastic Mesh Monitor Environment Configuration
# Copy this file to .env and configure for your setup

# ===== RADIO CONNECTION (REQUIRED) =====
# TCP connection to Meshtastic device
TCP_SERVER=192.168.68.73
TCP_PORT=4403

# Alternative: Serial connection (uncomment to use instead of TCP)
# SERIAL_DEVICE=/dev/ttyUSB0

# ===== AI INTEGRATION (OPTIONAL) =====
# Google Gemini API for AI responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Radio Node Short Name (leave empty to use radio's short name, or override with custom callsign)
NODE_SHORT_NAME=

# Radio Node Long Name (leave empty to use radio's long name, or override with custom identifier)
NODE_LONG_NAME=

# ===== NODE POSITION (OPTIONAL) =====
# Fixed position for your node if GPS is unavailable
NODE_LATITUDE=
NODE_LONGITUDE=
NODE_ALTITUDE=

# ===== APPLICATION SETTINGS =====
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ===== CHANNEL CONFIGURATION =====
# Channel numbers for different message types
# Default: 0=public, 1=admin
PUBLIC_CHANNEL=0
ADMIN_CHANNEL=1
ALERT_CHANNEL=1
FORECAST_CHANNEL=1
SITREP_CHANNEL=1

# ===== HOP LIMIT (OPTIONAL) =====
# Default hop limit for messages (1-3 typical, higher = more mesh hops)
HOP_LIMIT=3
WANT_ACK=true
